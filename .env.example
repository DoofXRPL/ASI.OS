# ASI OS — environment
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# There is deliberately no service-role or secret Supabase key here. ASI OS
# reaches the database only as the signed-in user, so Row Level Security is
# always in force. `npm run guard:service-role` fails the build if application
# code ever references a privileged credential.

# ── Required ─────────────────────────────────────────────────────────────────
# Without both of these, every private route is unreachable and the sign-in page
# says exactly which variables are missing. That is intentional: an unconfigured
# deployment exposes nothing.

NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (formerly the "anon" key). Requests made with it are
# subject to Row Level Security, which is precisely why it is the only key used.
# `NEXT_PUBLIC_SUPABASE_ANON_KEY` is accepted as a fallback for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Proves to `public.request_early_access()` that a call came from this deployment
# rather than from anybody who read the publishable key out of the page source.
# Without it the early-access form records nothing and says so — which is the
# intended state of a deployment nobody has configured, not a bug to work around.
#
# It is not a privileged credential: it grants exactly one capability, calling one
# insert-only function, and it reads nothing. `npm run guard:service-role` keeps
# it out of every file but `lib/early-access/intake-key.ts` and fails the build on
# any NEXT_PUBLIC_ spelling of it.
#
# Generate it, and the statement that registers its digest, with:
#
#   npm run intake:key
#
# See docs/SECURITY.md § "Configuring the door".
ASI_INTAKE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# A second, independent check on ownership. When set, an account must BOTH be
# flagged as owner in the database AND sign in with this address to be treated as
# the owner. Leave empty to rely on the database flag alone.
ASI_OWNER_EMAIL=

# ── Development only ─────────────────────────────────────────────────────────

# Skips the sign-in screen while developing by signing in for real, on your
# behalf, with these credentials. Authentication cannot simply be switched off:
# Row Level Security answers as somebody, so with no caller every policy matches
# nothing and the app is empty rather than open.
#
# Both variables are required, and both are ignored entirely in a production
# build. When active, the account panel says the session was created
# automatically — it is never silent.

ASI_DEV_SIGN_IN_EMAIL=
ASI_DEV_SIGN_IN_PASSWORD=

# ── Testing only ─────────────────────────────────────────────────────────────

# A disposable PostgreSQL database for the Row Level Security suite. The database
# name must contain "test": the suite drops and recreates schemas.
# Not required to run the application.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/asi_test
