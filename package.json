{
  "name": "asi-os",
  "version": "0.1.0",
  "private": true,
  "description": "ASI OS (Adaptive Systems Interface) — a private personal intelligence and coordination layer.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:all": "vitest run",
    "db:reset": "tsx scripts/db-reset.ts",
    "guard:service-role": "tsx scripts/guard-service-role.ts",
    "verify": "npm run typecheck && npm run lint && npm run guard:service-role && npm run test:unit && npm run test:rls && npm run build"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.2.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.11",
    "happy-dom": "^20.11.1",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
